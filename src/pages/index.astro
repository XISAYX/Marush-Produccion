import ItemSection from '../components/itemSection.jsx'; // <--- Coincide con la minúscula de tu archivo
import Footer from '../components/Footer.jsx';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Marush | Reserva de la Biosfera Barranca de Metztitlán</title>
    
    {/* PRECARGA DE RECURSOS ESENCIALES */}
